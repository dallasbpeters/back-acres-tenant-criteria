{
  "name": "back-acres-tenant-criteria",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check": "ultracite check --error-on-warnings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "next dev",
    "fix": "ultracite fix",
    "postinstall": "node scripts/copy-pdf-assets.cjs",
    "prepare": "husky",
    "start": "next start",
    "test": "npm run test:unit && npm run test:stripe",
    "test:e2e": "playwright test",
    "test:signing": "node tests/support/run-lease-signing.cjs",
    "test:stripe": "vitest run --config vitest.stripe.config.mts",
    "test:stripe:coverage": "npm run test:stripe -- --coverage",
    "test:unit": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "postcss": "8.5.29"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "next": "^15.5.0",
    "next-auth": "^4.24.15",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.1.0",
    "react-pdf": "^11.0.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-signature-canvas": "^1.0.7",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "ultracite": "7.10.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
