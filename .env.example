# Keep false until your actual screening criteria have been approved.
ACCEPT_ACKNOWLEDGMENTS=false

# Resend (server only) — enter real values in Vercel Project > Settings > Environment Variables
RESEND_API_KEY=
FROM_EMAIL="Back Acres Rentals <noreply@your-verified-domain.com>"
LANDLORD_EMAIL=
TANDRA_EMAIL=

# Optional shared code given to applicants privately; leave blank to disable.
ACCESS_CODE=

# Private adverse-action workspace (server-only)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Google OAuth web client. Secrets stay server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3191
# Optional exact email allowlist; if omitted, uses LANDLORD_EMAIL and TANDRA_EMAIL.
# An explicitly empty list denies all access.
# ADMIN_EMAILS=owner@example.com,second@example.com

# Extra approved Google accounts when ADMIN_EMAILS is omitted.
# ADDITIONAL_ADMIN_EMAILS=another-owner@example.com
