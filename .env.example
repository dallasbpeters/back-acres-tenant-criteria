# Keep false until your actual screening criteria have been approved.
ACCEPT_ACKNOWLEDGMENTS=false

# Resend (server only) — enter real values in Vercel Project > Settings > Environment Variables
RESEND_API_KEY=
FROM_EMAIL="Back Acres Rentals <noreply@your-verified-domain.com>"
LANDLORD_EMAIL=
TANDRA_EMAIL=

# Optional shared code given to applicants privately; leave blank to disable.
ACCESS_CODE=

# Private adverse-action workspace (server-only)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Generate a unique random password with at least 32 characters.
ADMIN_PASSWORD=
